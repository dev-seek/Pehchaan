# Copy to .env only if you want real speech. With no keys at all, `make demo` runs the whole product with a labelled
# mock for speech. Do not leave a placeholder in a key: any value here is treated as a real key.

# Real speech, the meaning check and the LLM judge. Without it: mock speech, and pasted text still runs the engine.
OPENAI_API_KEY=

# Passcode for live routes when PEHCHAAN_MODE=public. `make demo` uses review-demo unless you set this.
# DEMO_PASSCODE=review-demo

# local = developer tools on. public = what visitors get (`make demo` sets this). ENV=production is for the real server.
# PEHCHAAN_MODE=public
# ENV=production

# 1 = use mock speech when no OpenAI key is set. Ignored when ENV=production. `make demo` sets this.
# PEHCHAAN_MOCK_SPEECH=1

# Optional. Only used by tools/make_audio.py to create synthetic development audio, and by the Deepgram example.
SARVAM_API_KEY=
DEEPGRAM_API_KEY=

# Optional V2 gateway settings. Generate distinct 24+ character tokens. Leave blank for the original demo.
# PEHCHAAN_V2_TOKEN=
# PEHCHAAN_V2_REVIEW_TOKEN=
# PEHCHAAN_V2_POLICY=delivery
# PEHCHAAN_V2_TENANTS=/path/to/tenants.yaml
